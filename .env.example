# Firebase *web* app config. Firebase console > Project settings > Your apps > Add app > Web (</>).
# The Android app's google-services.json is NOT enough: a web app has its own appId.
# These values are public identifiers (shipped to the browser), not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sprout-babynames.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sprout-babynames
NEXT_PUBLIC_FIREBASE_APP_ID=
